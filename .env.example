# --- App ---
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
# Used by the app (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://eaap:eaap@localhost:5432/eaap
# Used by Alembic (psycopg driver, sync)
DATABASE_URL_SYNC=postgresql+psycopg://eaap:eaap@localhost:5432/eaap

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Platform admin ---
# Gates tenant provisioning (POST /tenants, minting API keys). Leave empty to
# disable admin endpoints entirely; set to a long random secret to enable them.
# Sent by operators as the `X-Admin-Token` header.
PLATFORM_ADMIN_TOKEN=

# --- Embedding provider ---
# Pinned platform-wide: changing the embedding model invalidates every stored
# vector and requires a full re-index. Chat models are per-agent config instead.
# openai | azure
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chat providers ---
# An agent's `model` is routed to a provider at request time, so credentials
# are held per provider rather than for one configured default. A provider
# without a key returns 503 for agents that name its models; the rest keep
# working. OPENAI_API_KEY above doubles as the OpenAI chat credential.
ANTHROPIC_API_KEY=

# Azure OpenAI (only used when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Conversation Memory ---
# How many messages of a thread are replayed to the model. Bounds cost and
# context length only — the transcript keeps every turn regardless.
HISTORY_WINDOW=20
HISTORY_TTL_SECONDS=86400

# The graph checkpointer's own psycopg pool, separate from the app's SQLAlchemy
# engine because LangGraph's saver speaks psycopg directly. It reaches the same
# database via DATABASE_URL_SYNC.
CHECKPOINTER_POOL_SIZE=10
CHECKPOINTER_OPEN_TIMEOUT=10.0

# --- MCP integrations ---
# Fernet key for credentials the platform has to replay rather than verify —
# today, MCP server bearer tokens. Unlike our own API keys these cannot be
# hashed, so they are encrypted under this key. Empty means the platform refuses
# to store a credential at all rather than writing one in the clear. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Whether a tenant-registered MCP URL may resolve to a private, loopback, or
# link-local address. The platform dials these URLs itself, from inside its own
# network, with its own cloud identity — so leave this off in any shared
# environment. Turn it on locally to reach an MCP server on localhost.
MCP_ALLOW_PRIVATE_ADDRESSES=false

# How long a discovered tool list is reused before the server is asked again.
# Discovery is a round trip per server per model call, and a tool list does not
# change between two turns of one conversation.
MCP_TOOL_CACHE_TTL_SECONDS=300

# --- Agent ---
AGENT_MAX_RETRIES=2
